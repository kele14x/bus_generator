// File: {{ top_name }}_regs.v
// Brief: Register block generate for {{ top_name }}
`timescale 1 ns / 1 ps
//
`default_nettype none

module {{ top_name }}_regs (
    input  wire        s_axi_aclk,
    input  wire        s_axi_aresetn,
    //
    input  wire [{{ '{:2d}'.format(addr_width-1) }}:0] s_axi_awaddr,
    input  wire [ 2:0] s_axi_awprot,
    input  wire        s_axi_awvalid,
    output wire        s_axi_awready,
    //
    input  wire [{{ '{:2d}'.format(data_width-1) }}:0] s_axi_wdata,
    input  wire [{{ '{:2.0f}'.format(data_width/8-1) }}:0] s_axi_wstrb,
    input  wire        s_axi_wvalid,
    output wire        s_axi_wready,
    //
    output wire [ 1:0] s_axi_bresp,
    output wire        s_axi_bvalid,
    input  wire        s_axi_bready,
    //
    input  wire [{{ '{:2d}'.format(addr_width-1) }}:0] s_axi_araddr,
    input  wire [ 2:0] s_axi_arprot,
    input  wire        s_axi_arvalid,
    output wire        s_axi_arready,
    //
    output wire [{{ '{:2d}'.format(data_width-1) }}:0] s_axi_rdata,
    output wire [ 1:0] s_axi_rresp,
    output wire        s_axi_rvalid,
    input  wire        s_axi_rready
    {%- for field in fields %}
        {%- if field.is_hw_readable or field.is_hw_writable -%}
    ,
    // {{ field.hierarchy }}
            {%- if field.is_hw_writable -%}
    ,
    input  wire [{{ '{:2d}'.format(field.width-1) }}:0] {{ field.name }}_in
            {%- endif %}
            {%- if field.is_hw_readable -%}
    ,
    output wire [{{ '{:2d}'.format(field.width-1) }}:0] {{ field.name }}_out
            {%- endif %}
        {%- endif %}
    {%- endfor %}
    {%- for mem in mems -%}
    ,
    // {{ mem.hierarchy }},
    output wire [{{ '{:2d}'.format(mem.addr_width-1) }}:0] {{ mem.name }}_addr,
    output wire        {{ mem.name }}_en,
    output wire        {{ mem.name }}_we,
    output wire [{{ '{:2d}'.format(mem.width-1) }}:0] {{ mem.name }}_din,
    output wire [{{ '{:2.0f}'.format(data_width/8-1) }}:0] {{ mem.name }}_be,
    input  wire [{{ '{:2d}'.format(mem.width-1) }}:0] {{ mem.name }}_dout,
    input  wire        {{ mem.name }}_valid
    {%- endfor %}
);

    localparam integer ADDR_WIDTH = {{ addr_width }};
    localparam integer DATA_WIDTH = {{ data_width }};
    localparam integer STRB_WIDTH = DATA_WIDTH / 8;

    wire                  aclk;
    wire                  aresetn;

    reg                   head_valid;
    reg                   head_write;
    reg  [ADDR_WIDTH-1:0] head_addr;
    reg  [DATA_WIDTH-1:0] head_wdata;
    reg  [STRB_WIDTH-1:0] head_wstrb;

    wire [DATA_WIDTH-1:0] sw_byte_mask;

    reg                   ar_back_valid;
    reg  [ADDR_WIDTH-1:0] ar_back_addr;
    reg                   aw_back_valid;
    reg  [ADDR_WIDTH-1:0] aw_back_addr;
    reg                   w_back_valid;
    reg  [DATA_WIDTH-1:0] w_back_data;
    reg  [STRB_WIDTH-1:0] w_back_strb;
    reg                   priority_read;

    reg  [           5:0] b_outstanding;
    reg  [           1:0] r_outstanding;
    reg  [           5:0] b_wait_ack;
    reg  [           1:0] r_wait_ack;
    reg  [           5:0] b_pending;
    reg  [           1:0] r_pending;
    reg  [          31:0] b_err_fifo;
    reg  [DATA_WIDTH-1:0] r_slot0;
    reg  [DATA_WIDTH-1:0] r_slot1;
    reg                   r_err_slot0;
    reg                   r_err_slot1;

    wire                  b_hsk;
    wire                  r_hsk;
    wire                  wr_ack_fire;
    wire                  rd_ack_fire;
    wire                  b_credit;
    wire                  r_credit;
    wire                  issue;
    wire                  issue_write;
    wire                  issue_read;
    wire                  head_available;
    wire                  read_waiting;
    wire                  write_waiting;
    wire                  grant_read;
    wire                  grant_write;
    wire                  load_read_back;
    wire                  load_read_direct;
    wire                  load_write_back;
    wire                  ar_hsk;
    wire                  aw_hsk;
    wire                  w_hsk;

    wire [ADDR_WIDTH-1:0] int_addr;
    wire [DATA_WIDTH-1:0] int_wr_data;
    wire [STRB_WIDTH-1:0] int_wr_strb;
    wire                  int_wr_en;
    wire                  int_rd_en;
    wire                  rd_mem_pending;
    wire                  rd_mem_valid;
    wire                  rd_mem_issue;
    reg                   int_wr_ack;
    reg                   int_wr_err;
    reg                   int_wr_err_next;
    reg                   int_rd_ack;
    reg                   int_rd_err;
    reg                   int_rd_err_next;
    reg  [DATA_WIDTH-1:0] int_rd_data;

    integer b_idx;

    assign aclk    = s_axi_aclk;
    assign aresetn = s_axi_aresetn;

    assign b_hsk          = s_axi_bvalid && s_axi_bready;
    assign r_hsk          = s_axi_rvalid && s_axi_rready;
    assign wr_ack_fire    = int_wr_ack && (b_wait_ack != 6'd0);
    assign rd_ack_fire    = int_rd_ack && (r_wait_ack != 2'd0);
    assign b_credit       = (b_outstanding != 6'd32) || b_hsk;
    assign r_credit       = (r_outstanding != 2'd2) || r_hsk;
    assign issue          = head_valid && (head_write ? b_credit : (r_credit && !rd_mem_pending));
    assign issue_write    = issue && head_write;
    assign issue_read     = issue && !head_write;
    assign head_available = !head_valid || issue;
    assign read_waiting   = ar_back_valid || s_axi_arvalid;
    assign write_waiting  = aw_back_valid && w_back_valid;
    assign grant_read     = head_available && (r_credit && !rd_mem_pending) && read_waiting && (!write_waiting || priority_read);
    assign grant_write    = head_available && b_credit && write_waiting && (!read_waiting || !priority_read);
    assign load_read_back = grant_read && ar_back_valid;
    assign load_read_direct = grant_read && !ar_back_valid && s_axi_arvalid;
    assign load_write_back = grant_write;
    assign ar_hsk         = s_axi_arvalid && s_axi_arready;
    assign aw_hsk         = s_axi_awvalid && s_axi_awready;
    assign w_hsk          = s_axi_wvalid && s_axi_wready;

    assign int_addr       = head_addr;
    assign int_wr_data    = head_wdata;
    assign int_wr_strb    = head_wstrb;
    assign int_wr_en      = issue_write;
    assign int_rd_en      = issue_read;

    genvar sw_byte_idx;
    generate
        for (sw_byte_idx = 0; sw_byte_idx < STRB_WIDTH; sw_byte_idx = sw_byte_idx + 1) begin : gen_sw_byte_mask
            assign sw_byte_mask[sw_byte_idx*8 +: 8] = {8{int_wr_strb[sw_byte_idx]}};
        end
    endgenerate

    assign s_axi_bvalid  = b_pending != 6'd0;
    assign s_axi_bresp   = b_err_fifo[0] ? 2'b10 : 2'b00;
    assign s_axi_rvalid  = r_pending != 2'd0;
    assign s_axi_rdata   = r_slot0;
    assign s_axi_rresp   = r_err_slot0 ? 2'b10 : 2'b00;
    assign s_axi_arready = !ar_back_valid || load_read_back;
    assign s_axi_awready = !aw_back_valid || load_write_back;
    assign s_axi_wready  = !w_back_valid || load_write_back;

    always @(posedge aclk) begin
        if (!aresetn) begin
            priority_read <= 1'b1;
        end else if (grant_read) begin
            priority_read <= 1'b0;
        end else if (grant_write) begin
            priority_read <= 1'b1;
        end
    end

    always @(posedge aclk) begin
        if (!aresetn) begin
            head_valid <= 1'b0;
            head_write <= 1'b0;
            head_addr <= {ADDR_WIDTH{1'b0}};
            head_wdata <= {DATA_WIDTH{1'b0}};
            head_wstrb <= {STRB_WIDTH{1'b0}};
            ar_back_valid <= 1'b0;
            ar_back_addr <= {ADDR_WIDTH{1'b0}};
            aw_back_valid <= 1'b0;
            aw_back_addr <= {ADDR_WIDTH{1'b0}};
            w_back_valid <= 1'b0;
            w_back_data <= {DATA_WIDTH{1'b0}};
            w_back_strb <= {STRB_WIDTH{1'b0}};
        end else begin
            if (load_read_back) begin
                head_valid <= 1'b1;
                head_write <= 1'b0;
                head_addr  <= ar_back_addr;
            end else if (load_read_direct) begin
                head_valid <= 1'b1;
                head_write <= 1'b0;
                head_addr  <= s_axi_araddr;
            end else if (load_write_back) begin
                head_valid <= 1'b1;
                head_write <= 1'b1;
                head_addr  <= aw_back_addr;
                head_wdata <= w_back_data;
                head_wstrb <= w_back_strb;
            end else if (issue) begin
                head_valid <= 1'b0;
            end

            if (ar_hsk && !load_read_direct) begin
                ar_back_valid <= 1'b1;
                ar_back_addr  <= s_axi_araddr;
            end else if (load_read_back) begin
                ar_back_valid <= 1'b0;
            end

            if (aw_hsk) begin
                aw_back_valid <= 1'b1;
                aw_back_addr  <= s_axi_awaddr;
            end else if (load_write_back) begin
                aw_back_valid <= 1'b0;
            end

            if (w_hsk) begin
                w_back_valid <= 1'b1;
                w_back_data  <= s_axi_wdata;
                w_back_strb  <= s_axi_wstrb;
            end else if (load_write_back) begin
                w_back_valid <= 1'b0;
            end
        end
    end

    always @(posedge aclk) begin
        if (!aresetn) begin
            int_wr_ack <= 1'b0;
            int_wr_err <= 1'b0;
            int_rd_ack <= 1'b0;
            int_rd_err <= 1'b0;
        end else begin
            int_wr_ack <= issue_write;
            if (issue_write) begin
                int_wr_err <= int_wr_err_next;
            end

            int_rd_ack <= (issue_read && !rd_mem_pending && !rd_mem_issue) || (rd_mem_pending && rd_mem_valid);
            if (issue_read) begin
                int_rd_err <= int_rd_err_next;
            end
        end
    end

    always @(posedge aclk) begin
        if (!aresetn) begin
            b_outstanding <= 6'd0;
            r_outstanding <= 2'd0;
            b_wait_ack <= 6'd0;
            r_wait_ack <= 2'd0;
            b_pending <= 6'd0;
            r_pending <= 2'd0;
            b_err_fifo <= 32'd0;
            r_slot0 <= {DATA_WIDTH{1'b0}};
            r_slot1 <= {DATA_WIDTH{1'b0}};
            r_err_slot0 <= 1'b0;
            r_err_slot1 <= 1'b0;
        end else begin
            case ({issue_write, b_hsk})
                2'b10:   b_outstanding <= b_outstanding + 6'd1;
                2'b01:   b_outstanding <= b_outstanding - 6'd1;
                default: b_outstanding <= b_outstanding;
            endcase

            case ({issue_read, r_hsk})
                2'b10:   r_outstanding <= r_outstanding + 2'd1;
                2'b01:   r_outstanding <= r_outstanding - 2'd1;
                default: r_outstanding <= r_outstanding;
            endcase

            case ({issue_write, wr_ack_fire})
                2'b10:   b_wait_ack <= b_wait_ack + 6'd1;
                2'b01:   b_wait_ack <= b_wait_ack - 6'd1;
                default: b_wait_ack <= b_wait_ack;
            endcase

            case ({issue_read, rd_ack_fire})
                2'b10:   r_wait_ack <= r_wait_ack + 2'd1;
                2'b01:   r_wait_ack <= r_wait_ack - 2'd1;
                default: r_wait_ack <= r_wait_ack;
            endcase

            case ({wr_ack_fire, b_hsk})
                2'b10: begin
                    b_err_fifo[b_pending[4:0]] <= int_wr_err;
                    b_pending <= b_pending + 6'd1;
                end
                2'b01: begin
                    for (b_idx = 0; b_idx < 31; b_idx = b_idx + 1) begin
                        b_err_fifo[b_idx] <= b_err_fifo[b_idx + 1];
                    end
                    b_err_fifo[31] <= 1'b0;
                    b_pending <= b_pending - 6'd1;
                end
                2'b11: begin
                    for (b_idx = 0; b_idx < 31; b_idx = b_idx + 1) begin
                        b_err_fifo[b_idx] <= b_err_fifo[b_idx + 1];
                    end
                    b_err_fifo[b_pending[4:0] - 5'd1] <= int_wr_err;
                    b_pending <= b_pending;
                end
                default: b_pending <= b_pending;
            endcase

            case ({rd_ack_fire, r_hsk})
                2'b10: begin
                    if (r_pending == 2'd0) begin
                        r_slot0 <= int_rd_data;
                        r_err_slot0 <= int_rd_err;
                    end else begin
                        r_slot1 <= int_rd_data;
                        r_err_slot1 <= int_rd_err;
                    end
                    r_pending <= r_pending + 2'd1;
                end
                2'b01: begin
                    if (r_pending == 2'd2) begin
                        r_slot0 <= r_slot1;
                        r_err_slot0 <= r_err_slot1;
                    end
                    r_pending <= r_pending - 2'd1;
                end
                2'b11: begin
                    if (r_pending == 2'd1) begin
                        r_slot0 <= int_rd_data;
                        r_err_slot0 <= int_rd_err;
                    end else begin
                        r_slot0 <= r_slot1;
                        r_err_slot0 <= r_err_slot1;
                        r_slot1 <= int_rd_data;
                        r_err_slot1 <= int_rd_err;
                    end
                end
                default: r_pending <= r_pending;
            endcase
        end
    end


    //--------------------------------------------------------------------------
    // Address decoder
    //--------------------------------------------------------------------------
    {%- for field in fields %}

    wire {{ field.name }}_strb;

    assign {{ field.name }}_strb = (int_addr[{{ addr_width-1 }}:{{ addr_width_lsb }}] == 'h{{ '{:x}'.format(field.aligned_address) }});
    {%- endfor %}
    {%- for mem in mems %}

    wire {{ mem.name }}_strb;
    reg  {{ mem.name }}_rd_sel;

    assign {{ mem.name }}_strb = (int_addr[{{ addr_width-1 }}:{{ mem.addr_msb+1 }}] == 'h{{ '{:x}'.format(mem.aligned_address) }});
    {%- endfor %}

    assign rd_mem_pending = 1'b0{% for mem in mems %}{% if mem.is_sw_readable %} || {{ mem.name }}_rd_sel{% endif %}{% endfor %};
    assign rd_mem_valid = 1'b0{% for mem in mems %}{% if mem.is_sw_readable %} || ({{ mem.name }}_rd_sel && {{ mem.name }}_valid){% endif %}{% endfor %};
    assign rd_mem_issue = 1'b0{% for mem in mems %}{% if mem.is_sw_readable %} || (int_rd_en && {{ mem.name }}_strb){% endif %}{% endfor %};

    always @(*) begin
        int_wr_err_next = 1'b1;
        {%- for field in fields %}
        {%- if field.is_sw_writable %}
        if ({{ field.name }}_strb) begin
            int_wr_err_next = 1'b0;
        end
        {%- endif %}
        {%- endfor %}
        {%- for mem in mems %}
        {%- if mem.is_sw_writable %}
        if ({{ mem.name }}_strb) begin
            int_wr_err_next = 1'b0;
        end
        {%- endif %}
        {%- endfor %}
    end

    always @(*) begin
        int_rd_err_next = 1'b1;
        {%- for field in fields %}
        {%- if field.is_sw_readable %}
        if ({{ field.name }}_strb) begin
            int_rd_err_next = 1'b0;
        end
        {%- endif %}
        {%- endfor %}
        {%- for mem in mems %}
        {%- if mem.is_sw_readable %}
        if ({{ mem.name }}_strb) begin
            int_rd_err_next = 1'b0;
        end
        {%- endif %}
        {%- endfor %}
    end

    {%- for mem in mems %}
    always @(posedge aclk) begin
        if (!aresetn) begin
            {{ mem.name }}_rd_sel <= 1'b0;
        {%- if mem.is_sw_readable %}
        end else if (issue_read) begin
            {{ mem.name }}_rd_sel <= {{ mem.name }}_strb;
        {%- endif %}
        end else if (int_rd_ack) begin
            {{ mem.name }}_rd_sel <= 1'b0;
        end
    end
    {%- endfor %}


    //--------------------------------------------------------------------------
    // Field logic
    //--------------------------------------------------------------------------
    {%- for field in fields %}

    // Field {{ field.hierarchy }} @'h{{ '{:x}'.format(field.address) }}[{{ field.msb }}:{{ field.lsb }}]

    reg [{{ field.width-1 }}:0] {{ field.name }}_value;
    {%- if field.implements_storage and field.is_sw_writable %}
    wire [{{ field.width-1 }}:0] {{ field.name }}_sw_mask;
    assign {{ field.name }}_sw_mask = sw_byte_mask[{{ field.msb }}:{{ field.lsb }}];
    {%- endif %}
    {%- if field.implements_storage %}

    always @(posedge aclk) begin
        if (!aresetn) begin
            {{ field.name }}_value <= 'h{{ '{:x}'.format(field.reset) }};
        {%- if field.is_sw_writable %}
        end else if (int_wr_en && {{ field.name }}_strb) begin
            {%- if field.is_hw_writable %}
            {{ field.name }}_value <= ({{ field.name }}_in & ~{{ field.name }}_sw_mask) |
                                       (int_wr_data[{{ field.msb }}:{{ field.lsb }}] & {{ field.name }}_sw_mask);
            {%- else %}
            {{ field.name }}_value <= ({{ field.name }}_value & ~{{ field.name }}_sw_mask) |
                                       (int_wr_data[{{ field.msb }}:{{ field.lsb }}] & {{ field.name }}_sw_mask);
            {%- endif %}
        {%- endif %}
        {%- if field.is_hw_writable %}
        end else begin
            {{ field.name }}_value <= {{ field.name }}_in;
        {%- endif %}
        end
    end

    {%- elif field.is_hw_writable %}

    always @(*) begin
        {{ field.name }}_value = {{ field.name }}_in;
    end
    {%- else %}

    initial begin
        {{ field.name }}_value = 'h{{ '{:x}'.format(field.reset) }};
    end
    {%- endif %}

    {%- if field.is_hw_readable %}

    assign {{ field.name }}_out = {{ field.name }}_value;
    {%- endif %}
    {%- endfor %}


    //--------------------------------------------------------------------------
    // Memory logic
    //--------------------------------------------------------------------------
    {%- for mem in mems %}

    // Memory {{ mem.hierarchy }} @'h{{ '{:x}'.format(mem.address) }}

    assign {{ mem.name }}_addr = int_addr[{{ mem.addr_msb }}:{{ mem.addr_lsb }}];
    {%- if mem.is_sw_readable and mem.is_sw_writable %}
    assign {{ mem.name }}_en   = ((int_rd_en && {{ mem.name }}_strb) ||
                                  (int_wr_en && {{ mem.name }}_strb && (|int_wr_strb)));
    assign {{ mem.name }}_we   = (int_wr_en && {{ mem.name }}_strb && (|int_wr_strb));
    assign {{ mem.name }}_din  = int_wr_data[{{ mem.width-1 }}:0];
    assign {{ mem.name }}_be   = (int_wr_en && {{ mem.name }}_strb) ? int_wr_strb : {STRB_WIDTH{1'b0}};
    {%- elif mem.is_sw_readable %}
    assign {{ mem.name }}_en   = (int_rd_en && {{ mem.name }}_strb);
    assign {{ mem.name }}_we   = 1'b0;
    assign {{ mem.name }}_din  = int_wr_data[{{ mem.width-1 }}:0];
    assign {{ mem.name }}_be   = {STRB_WIDTH{1'b0}};
    {%- elif mem.is_sw_writable %}
    assign {{ mem.name }}_en   = (int_wr_en && {{ mem.name }}_strb && (|int_wr_strb));
    assign {{ mem.name }}_we   = (int_wr_en && {{ mem.name }}_strb && (|int_wr_strb));
    assign {{ mem.name }}_din  = int_wr_data[{{ mem.width-1 }}:0];
    assign {{ mem.name }}_be   = (int_wr_en && {{ mem.name }}_strb) ? int_wr_strb : {STRB_WIDTH{1'b0}};
    {%- else %}
    assign {{ mem.name }}_en   = 1'b0;
    assign {{ mem.name }}_we   = 1'b0;
    assign {{ mem.name }}_din  = int_wr_data[{{ mem.width-1 }}:0];
    assign {{ mem.name }}_be   = {STRB_WIDTH{1'b0}};
    {%- endif %}
    {%- endfor %}


    //--------------------------------------------------------------------------
    // Register readback
    //--------------------------------------------------------------------------

    reg [DATA_WIDTH-1:0] field_rd_data;
    reg [DATA_WIDTH-1:0] field_rd_data_next;

    reg        field_strb;

    always @(*) begin
        field_rd_data_next = {DATA_WIDTH{1'b0}};
        {%- for field in fields %}
        {%- if field.is_sw_readable %}
        if (int_rd_en && {{ field.name }}_strb) begin
            field_rd_data_next[{{ field.msb }}:{{ field.lsb }}] = field_rd_data_next[{{ field.msb }}:{{ field.lsb }}] | {{ field.name }}_value;
        end
        {%- endif %}
        {%- endfor %}
    end

    always @(posedge aclk) begin
        if (!aresetn) begin
            field_rd_data <= {DATA_WIDTH{1'b0}};
        end else begin
            field_rd_data <= field_rd_data_next;
        end
    end

    always @(posedge aclk) begin
        if (!aresetn) begin
            field_strb <= 1'b0;
        end else begin
            field_strb <= 1'b0;
            {%- for field in fields %}
            {%- if field.is_sw_readable %}
            if (int_rd_en && {{ field.name }}_strb) begin
                field_strb <= 1'b1;
            end
            {%- endif %}
            {%- endfor %}
        end
    end

    always @(*) begin
        int_rd_data = {DATA_WIDTH{1'b0}};
        if (field_strb) begin
            int_rd_data = int_rd_data | field_rd_data;
        end
        {%- for mem in mems %}
        if ({{ mem.name }}_rd_sel) begin
            int_rd_data[{{ mem.width-1 }}:0] = int_rd_data[{{ mem.width-1 }}:0] | {{ mem.name }}_dout;
        end
        {%- endfor %}
    end

endmodule

`default_nettype wire
