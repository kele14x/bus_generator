// File: tb_{{ top_name }}_regs.v
// Breif: Testbench for module {{ top_name }}.
`timescale 1 ns / 1 ps
//
`default_nettype none

module tb_{{ top_name }}_regs;

    reg         s_axi_aclk;
    reg         s_axi_aresetn;
    //
    reg  [{{ '{:2d}'.format(addr_width-1) }}:0] s_axi_awaddr;
    reg  [ 2:0] s_axi_awprot;
    reg         s_axi_awvalid;
    wire        s_axi_awready;
    //
    reg  [{{ '{:2d}'.format(data_width-1) }}:0] s_axi_wdata;
    reg  [{{ '{:2.0f}'.format(data_width/8-1) }}:0] s_axi_wstrb;
    reg         s_axi_wvalid;
    wire        s_axi_wready;
    //
    wire [ 1:0] s_axi_bresp;
    wire        s_axi_bvalid;
    reg         s_axi_bready;
    //
    reg  [{{ '{:2d}'.format(addr_width-1) }}:0] s_axi_araddr;
    reg  [ 2:0] s_axi_arprot;
    reg         s_axi_arvalid;
    wire        s_axi_arready;
    //
    wire [{{ '{:2d}'.format(data_width-1) }}:0] s_axi_rdata;
    wire [ 1:0] s_axi_rresp;
    wire        s_axi_rvalid;
    reg         s_axi_rready;

    {%- for field in fields %}
        {%- if field.is_hw_readable or field.is_hw_writable %}
    // {{ field.hierarchy }}
            {%- if field.is_hw_writable %}
    reg  [{{ '{:6d}'.format(field.width-1) }}:0] {{ field.name }}_in;
            {%- endif %}
            {%- if field.is_hw_readable %}
    wire [{{ '{:6d}'.format(field.width-1) }}:0] {{ field.name }}_out;
            {%- endif %}
        {%- endif %}
    {%- endfor %}
    {%- for mem in mems %}
    // {{ mem.hierarchy }}
    wire [{{ '{:2d}'.format(mem.addr_width-1) }}:0] {{ mem.name }}_addr;
    wire        {{ mem.name }}_en;
    wire        {{ mem.name }}_we;
    wire [{{ '{:2d}'.format(mem.width-1) }}:0] {{ mem.name }}_din;
    wire [{{ '{:2.0f}'.format(data_width/8-1) }}:0] {{ mem.name }}_be;
    reg  [{{ '{:2d}'.format(mem.width-1) }}:0] {{ mem.name }}_dout;
    reg         {{ mem.name }}_valid;
    reg         {{ mem.name }}_range_valid_access;
    reg         {{ mem.name }}_range_invalid_access;
    {%- endfor %}

    integer errors;
    localparam integer MEMORY_READ_LATENCY = 3;

    task axi_reset();
        begin
            s_axi_awaddr  <= 0;
            s_axi_awprot  <= 0;
            s_axi_awvalid <= 0;
            //
            s_axi_wdata   <= 0;
            s_axi_wstrb   <= 0;
            s_axi_wvalid  <= 0;
            //
            s_axi_bready  <= 0;
            //
            s_axi_araddr  <= 0;
            s_axi_arprot  <= 0;
            s_axi_arvalid <= 0;
            //
            s_axi_rready  <= 0;
        end
    endtask

    task regs_reset();
        begin
            {%- for field in fields %}
                {%- if field.is_hw_writable %}
            // {{ field.hierarchy }}
            {{ field.name }}_in <= 0;
                {%- endif %}
            {%- endfor %}
            {%- for mem in mems %}

            // {{ mem.hierarchy }}
            {{ mem.name }}_dout <= 0;
            {{ mem.name }}_valid <= 0;
            {{ mem.name }}_range_valid_access <= 0;
            {{ mem.name }}_range_invalid_access <= 0;
            {%- endfor %}
        end
    endtask

    task reset();
        begin
            s_axi_aresetn <= 0;
            repeat(16) @(posedge s_axi_aclk);
            s_axi_aresetn <= 1;
            repeat(16) @(posedge s_axi_aclk);
        end
    endtask

    task axi_write_be(input  reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr,
                     input  reg [{{ '{:2d}'.format(data_width-1) }}:0] data,
                     input  reg [{{ '{:2.0f}'.format(data_width/8-1) }}:0] be,
                     output reg [ 1:0] resp);
        begin
            fork
                begin
                  s_axi_awaddr  <= addr;
                  s_axi_awprot  <= 0;
                  s_axi_awvalid <= 1;
                  @(posedge s_axi_aclk);
                  while (s_axi_awready == 0) begin
                      @(posedge s_axi_aclk);
                  end
                  s_axi_awvalid <= 0;
                end

                begin
                    s_axi_wdata  <= data;
                    s_axi_wstrb  <= be;
                    s_axi_wvalid <= 1;
                    @(posedge s_axi_aclk);
                    while (s_axi_wready == 0) begin
                        @(posedge s_axi_aclk);
                    end
                    s_axi_wvalid <= 0;
                end

                begin
                    s_axi_bready <= 0;
                    @(posedge s_axi_aclk);
                    while (s_axi_bvalid == 0) begin
                        @(posedge s_axi_aclk);
                    end
                    resp = s_axi_bresp;
                    s_axi_bready <= 1;
                    @(posedge s_axi_aclk);
                    s_axi_bready <= 0;
                end
            join
            $display("Write: addr = %x, data = %x, be = %x, resp = %x", addr, data, be, resp);
        end
    endtask

    task axi_write(input  reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr,
                   input  reg [{{ '{:2d}'.format(data_width-1) }}:0] data,
                   output reg [ 1:0] resp);
        begin
            axi_write_be(addr, data, { {{ '{:2.0f}'.format(data_width/8) }}{1'b1} }, resp);
        end
    endtask

    task axi_read(input  reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr,
                  output reg [{{ '{:2d}'.format(data_width-1) }}:0] data,
                  output reg [ 1:0] resp);
        begin
            fork
                begin
                    s_axi_araddr  <= addr;
                    s_axi_arprot  <= 0;
                    s_axi_arvalid <= 1;
                    @(posedge s_axi_aclk);
                    while (s_axi_arready == 0) begin
                        @(posedge s_axi_aclk);
                    end
                    s_axi_arvalid <= 0;
                end

                begin
                    s_axi_rready <= 0;
                    @(posedge s_axi_aclk);
                    while (s_axi_rvalid == 0) begin
                        @(posedge s_axi_aclk);
                    end
                    data = s_axi_rdata;
                    resp = s_axi_rresp;
                    s_axi_rready <= 1;
                    @(posedge s_axi_aclk);
                    s_axi_rready <= 0;
                end
            join
            $display("Read: addr = %x, data = %x, resp = %x", addr, data, resp);
        end
    endtask

    task check_resp(input reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr,
                    input reg [ 1:0] resp);
        begin
            if (resp !== 2'b00) begin
                errors = errors + 1;
                $display("FAIL: addr = %x unexpected resp = %b", addr, resp);
            end
        end
    endtask

    task check_error_resp(input reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr,
                          input reg [ 1:0] resp);
        begin
            if (resp !== 2'b10) begin
                errors = errors + 1;
                $display("FAIL: addr = %x expected SLVERR, got resp = %b", addr, resp);
            end
        end
    endtask

    task check_data(input reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr,
                    input reg [{{ '{:2d}'.format(data_width-1) }}:0] got,
                    input reg [{{ '{:2d}'.format(data_width-1) }}:0] exp);
        begin
            if (got !== exp) begin
                errors = errors + 1;
                $display("FAIL: addr = %x data got = %x exp = %x", addr, got, exp);
            end
        end
    endtask


    // DUT

    {{ top_name }}_regs DUT (
        .s_axi_aclk                              (s_axi_aclk),
        .s_axi_aresetn                           (s_axi_aresetn),
        //
        .s_axi_awaddr                            (s_axi_awaddr),
        .s_axi_awprot                            (s_axi_awprot),
        .s_axi_awvalid                           (s_axi_awvalid),
        .s_axi_awready                           (s_axi_awready),
        //
        .s_axi_wdata                             (s_axi_wdata),
        .s_axi_wstrb                             (s_axi_wstrb),
        .s_axi_wvalid                            (s_axi_wvalid),
        .s_axi_wready                            (s_axi_wready),
        //
        .s_axi_bresp                             (s_axi_bresp),
        .s_axi_bvalid                            (s_axi_bvalid),
        .s_axi_bready                            (s_axi_bready),
        //
        .s_axi_araddr                            (s_axi_araddr),
        .s_axi_arprot                            (s_axi_arprot),
        .s_axi_arvalid                           (s_axi_arvalid),
        .s_axi_arready                           (s_axi_arready),
        //
        .s_axi_rdata                             (s_axi_rdata),
        .s_axi_rresp                             (s_axi_rresp),
        .s_axi_rvalid                            (s_axi_rvalid),
        .s_axi_rready                            (s_axi_rready)
        {%- for field in fields %}
            {%- if field.is_hw_readable or field.is_hw_writable -%}
        ,
        // {{ field.hierarchy }}
                {%- if field.is_hw_writable -%}
        ,
        .{{ '{: <40}'.format(field.name + '_in') }}({{ field.name }}_in)
                {%- endif %}
                {%- if field.is_hw_readable -%}
        ,
        .{{ '{: <40}'.format(field.name + '_out') }}({{ field.name }}_out)
                {%- endif %}
            {%- endif %}
        {%- endfor %}
        {%- for mem in mems -%}
        ,
        // {{ mem.hierarchy }}
        .{{ '{: <40}'.format(mem.name + '_addr') }}({{ mem.name }}_addr),
        .{{ '{: <40}'.format(mem.name + '_en') }}({{ mem.name }}_en),
        .{{ '{: <40}'.format(mem.name + '_we') }}({{ mem.name }}_we),
        .{{ '{: <40}'.format(mem.name + '_din') }}({{ mem.name }}_din),
        .{{ '{: <40}'.format(mem.name + '_be') }}({{ mem.name }}_be),
        .{{ '{: <40}'.format(mem.name + '_dout') }}({{ mem.name }}_dout),
        .{{ '{: <40}'.format(mem.name + '_valid') }}({{ mem.name }}_valid)
        {%- endfor %}
    );

    {%- for field in fields %}
        {%- if field.implements_storage and field.is_sw_writable and field.is_hw_writable and field.is_sw_readable %}
    // Check the one-cycle software override for {{ field.hierarchy }}.
    always @(posedge s_axi_aclk) begin
        if (s_axi_aresetn && DUT.int_wr_en && DUT.{{ field.name }}_strb) begin
            #1;
            if (DUT.{{ field.name }}_value !==
                (({{ field.name }}_in & ~DUT.{{ field.name }}_sw_mask) |
                 (DUT.int_wr_data[{{ field.msb }}:{{ field.lsb }}] & DUT.{{ field.name }}_sw_mask))) begin
                errors = errors + 1;
                $display("FAIL: {{ field.hierarchy }} software/hardware merge mismatch");
            end
        end
    end
        {%- endif %}
    {%- endfor %}


    // Verify that external memory byte enables mirror AXI WSTRB on writes,
    // remain zero on reads, and suppress physical accesses for WSTRB=0.
    {%- for mem in mems %}
    always @(posedge s_axi_aclk) begin
        if (s_axi_aresetn && {{ mem.name }}_range_valid_access &&
            (DUT.int_wr_en || DUT.int_rd_en) &&
            !{{ mem.name }}_en) begin
            errors = errors + 1;
            $display("FAIL: {{ mem.hierarchy }} final valid address did not assert external memory enable");
        end
        if (s_axi_aresetn && {{ mem.name }}_range_invalid_access && {{ mem.name }}_en) begin
            errors = errors + 1;
            $display("FAIL: {{ mem.hierarchy }} out-of-range address asserted external memory enable");
        end
        if (s_axi_aresetn && DUT.int_rd_en && DUT.{{ mem.name }}_strb) begin
            {%- if mem.is_sw_readable %}
            if (!{{ mem.name }}_en || {{ mem.name }}_we ||
                ({{ mem.name }}_be !== { {{ '{:2.0f}'.format(data_width/8) }}{1'b0} })) begin
                errors = errors + 1;
                $display("FAIL: {{ mem.hierarchy }} readable access signal mismatch");
            end
            {%- else %}
            if ({{ mem.name }}_en || {{ mem.name }}_we ||
                (|{{ mem.name }}_be)) begin
                errors = errors + 1;
                $display("FAIL: {{ mem.hierarchy }} prohibited read reached external memory");
            end
            {%- endif %}
        end
        if (s_axi_aresetn && DUT.int_wr_en && DUT.{{ mem.name }}_strb) begin
            {%- if mem.is_sw_writable %}
            if (DUT.int_wr_strb == { {{ '{:2.0f}'.format(data_width/8) }}{1'b0} }) begin
                if ({{ mem.name }}_en || {{ mem.name }}_we || (|{{ mem.name }}_be)) begin
                    errors = errors + 1;
                    $display("FAIL: {{ mem.hierarchy }} WSTRB=0 issued a physical memory access");
                end
            end else if (!{{ mem.name }}_en || !{{ mem.name }}_we ||
                         ({{ mem.name }}_be !== DUT.int_wr_strb)) begin
                errors = errors + 1;
                $display("FAIL: {{ mem.hierarchy }} byte enable/write mismatch");
            end
            {%- else %}
            if ({{ mem.name }}_en || {{ mem.name }}_we ||
                (|{{ mem.name }}_be)) begin
                errors = errors + 1;
                $display("FAIL: {{ mem.hierarchy }} prohibited write reached external memory");
            end
            {%- endif %}
        end
    end
    {%- endfor %}


    // Memory Model

    {%- for mem in mems %}

    // {{ mem.hierarchy }}

    reg [31:0] {{ mem.name}}_mem [0:{{ mem.mementries }}];
    reg [{{ '{:2d}'.format(mem.width-1) }}:0] {{ mem.name}}_exp [0:{{ mem.mementries }}];
    reg [{{ '{:2d}'.format(mem.addr_width-1) }}:0] {{ mem.name}}_rd_addr_pipe [0:MEMORY_READ_LATENCY-1];
    reg [MEMORY_READ_LATENCY-1:0] {{ mem.name}}_rd_valid_pipe;
    integer {{ mem.name}}_rd_idx;
    integer {{ mem.name}}_be_idx;

    always @(posedge s_axi_aclk) begin
        if (s_axi_aresetn == 1'b0) begin
            {{ mem.name }}_dout <= 0;
            {{ mem.name }}_valid <= 0;
            {{ mem.name}}_rd_valid_pipe <= 0;
            for ({{ mem.name}}_rd_idx = 0; {{ mem.name}}_rd_idx < MEMORY_READ_LATENCY; {{ mem.name}}_rd_idx = {{ mem.name}}_rd_idx + 1) begin
                {{ mem.name}}_rd_addr_pipe[{{ mem.name}}_rd_idx] <= 0;
            end
        end else begin
            {{ mem.name}}_rd_valid_pipe <= { {{ mem.name}}_rd_valid_pipe[MEMORY_READ_LATENCY-2:0], {{ mem.name}}_en && !{{ mem.name}}_we };
            {{ mem.name}}_rd_addr_pipe[0] <= {{ mem.name}}_addr;
            for ({{ mem.name}}_rd_idx = 1; {{ mem.name}}_rd_idx < MEMORY_READ_LATENCY; {{ mem.name}}_rd_idx = {{ mem.name}}_rd_idx + 1) begin
                {{ mem.name}}_rd_addr_pipe[{{ mem.name}}_rd_idx] <= {{ mem.name}}_rd_addr_pipe[{{ mem.name}}_rd_idx - 1];
            end
            {{ mem.name }}_valid <= {{ mem.name}}_rd_valid_pipe[MEMORY_READ_LATENCY-1];
            if ({{ mem.name}}_rd_valid_pipe[MEMORY_READ_LATENCY-1]) begin
                {{ mem.name }}_dout <= {{ mem.name}}_mem[{{ mem.name}}_rd_addr_pipe[MEMORY_READ_LATENCY-1]];
            end
        end
    end

    always @(posedge s_axi_aclk) begin
        if ({{ mem.name}}_en == 1'b1 && {{ mem.name}}_we == 1'b1) begin
            for ({{ mem.name}}_be_idx = 0; {{ mem.name}}_be_idx < {{ mem.width // 8 }}; {{ mem.name}}_be_idx = {{ mem.name}}_be_idx + 1) begin
                if ({{ mem.name}}_be[{{ mem.name}}_be_idx]) begin
                    {{ mem.name}}_mem[{{ mem.name}}_addr][{{ mem.name}}_be_idx*8 +: 8] <=
                        {{ mem.name }}_din[{{ mem.name}}_be_idx*8 +: 8];
                end
            end
        end
    end

    {%- endfor %}


    // Stimulation
    //------------

    initial begin
        s_axi_aclk = 0;
        forever begin
            #5 s_axi_aclk = ~s_axi_aclk;
        end
    end

    initial begin : p_stimu
        reg [{{ '{:2d}'.format(addr_width-1) }}:0] addr;
        reg [{{ '{:2d}'.format(data_width-1) }}:0] wdata;
        reg [{{ '{:2d}'.format(data_width-1) }}:0] rdata;
        reg [{{ '{:2d}'.format(data_width-1) }}:0] expected;
        reg [{{ '{:2.0f}'.format(data_width/8-1) }}:0] be;
        reg [ 1:0] resp;
        integer i;

        errors = 0;

        // Wait reset done
        axi_reset();
        regs_reset();
        reset();

        // Write / read test
        {%- for field in fields %}

        // {{ field.hierarchy }}
        addr = 'h{{ '{:x}'.format(field.address) }};
            {%- if field.is_hw_writable %}
        {{ field.name }}_in <= $urandom();
        @(posedge s_axi_aclk);
            {%- endif %}
            {%- if field.is_sw_writable %}
        wdata = $urandom();
        axi_write(addr, wdata, resp);
        check_resp(addr, resp);
                {%- if field.is_hw_readable and not field.is_hw_writable %}
        if ({{ field.name }}_out !== wdata[{{ field.msb }}:{{ field.lsb }}]) begin
            errors = errors + 1;
            $display("FAIL: {{ field.hierarchy }} permitted write did not update hardware output");
        end
                {%- endif %}
            {%- endif %}
            {%- if field.is_sw_readable %}
        axi_read(addr, rdata, resp);
        check_resp(addr, resp);
                {%- if field.is_hw_writable %}
        check_data(addr, rdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }},
                   ({{ data_width }}'({{ field.name }}_in) << {{ field.lsb }}) & {{ data_width }}'h{{ '{:x}'.format(field.mask) }});
        expected = ({{ data_width }}'({{ field.name }}_in) << {{ field.lsb }}) & {{ data_width }}'h{{ '{:x}'.format(field.mask) }};
                {%- elif field.is_sw_writable %}
        check_data(addr, rdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }},
                   wdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }});
        expected = wdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }};
                {%- else %}
        check_data(addr, rdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }},
                   ({{ data_width }}'h{{ '{:x}'.format(field.reset) }} << {{ field.lsb }}) & {{ data_width }}'h{{ '{:x}'.format(field.mask) }});
        expected = ({{ data_width }}'h{{ '{:x}'.format(field.reset) }} << {{ field.lsb }}) & {{ data_width }}'h{{ '{:x}'.format(field.mask) }};
                {%- endif %}
            {%- endif %}
            {%- if field.implements_storage and field.is_sw_writable %}
        // Exercise every byte lane covered by {{ field.hierarchy }}.
                {%- for wstrb_case in field.wstrb_cases %}
        be = {{ '{:2.0f}'.format(data_width/8) }}'h{{ '{:x}'.format(wstrb_case.be) }};
        wdata = $urandom();
        axi_write_be(addr, wdata, be, resp);
        check_resp(addr, resp);
                {%- if not field.is_hw_writable %}
        expected = (expected & ~{{ data_width }}'h{{ '{:x}'.format(wstrb_case.mask) }}) |
                   (wdata & {{ data_width }}'h{{ '{:x}'.format(wstrb_case.mask) }});
                {%- endif %}
                {%- if field.is_sw_readable and not field.is_hw_writable %}
        axi_read(addr, rdata, resp);
        check_resp(addr, resp);
        check_data(addr, rdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }},
                   expected & {{ data_width }}'h{{ '{:x}'.format(field.mask) }});
                {%- endif %}
                {%- endfor %}

        // WSTRB=0 acknowledges normally without changing software-owned bits.
        wdata = $urandom();
        axi_write_be(addr, wdata, { {{ '{:2.0f}'.format(data_width/8) }}{1'b0} }, resp);
        check_resp(addr, resp);
                {%- if field.is_sw_readable and not field.is_hw_writable %}
        axi_read(addr, rdata, resp);
        check_resp(addr, resp);
        check_data(addr, rdata & {{ data_width }}'h{{ '{:x}'.format(field.mask) }},
                   expected & {{ data_width }}'h{{ '{:x}'.format(field.mask) }});
                {%- endif %}
            {%- endif %}
        {%- endfor %}
        // Field software-access permission tests.
        {%- for field in fields %}
            {%- set address_fields = fields | selectattr("address", "equalto", field.address) | list %}
            {%- if not (address_fields | selectattr("is_sw_writable") | list) %}

        // {{ field.hierarchy }} must reject software writes.
        addr = 'h{{ '{:x}'.format(field.address) }};
                {%- if field.is_hw_readable %}
        expected = {{ field.name }}_out;
                {%- endif %}
        wdata = $urandom();
        axi_write(addr, wdata, resp);
        check_error_resp(addr, resp);
                {%- if field.is_hw_readable %}
        if ({{ field.name }}_out !== expected[{{ field.width-1 }}:0]) begin
            errors = errors + 1;
            $display("FAIL: {{ field.hierarchy }} prohibited write changed hardware output");
        end
                {%- endif %}
            {%- endif %}
            {%- if not (address_fields | selectattr("is_sw_readable") | list) %}

        // {{ field.hierarchy }} must reject software reads without readback.
        addr = 'h{{ '{:x}'.format(field.address) }};
        axi_read(addr, rdata, resp);
        check_error_resp(addr, resp);
        check_data(addr, rdata, {{ data_width }}'h0);
            {%- endif %}
        {%- endfor %}
        {%- for mem in mems %}

        // {{ mem.hierarchy }}
        // The final valid word must select the external memory. The next two
        // words are outside its exact byte range and must return SLVERR
        // without selecting the memory.
            {%- if mem.is_sw_writable or mem.is_sw_readable %}
        addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address + mem.size - data_width // 8) }});
        wdata = $urandom();
        {{ mem.name }}_range_valid_access = 1'b1;
                {%- if mem.is_sw_writable %}
        axi_write(addr, wdata, resp);
                {%- else %}
        axi_read(addr, rdata, resp);
                {%- endif %}
        {{ mem.name }}_range_valid_access = 1'b0;
        check_resp(addr, resp);
            {%- endif %}

        addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address + mem.size) }});
        {{ mem.name }}_range_invalid_access = 1'b1;
            {%- if mem.is_sw_writable %}
        axi_write(addr, wdata, resp);
            {%- else %}
        axi_read(addr, rdata, resp);
            {%- endif %}
        {{ mem.name }}_range_invalid_access = 1'b0;
        check_error_resp(addr, resp);

        addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address + mem.size + data_width // 8) }});
        {{ mem.name }}_range_invalid_access = 1'b1;
            {%- if mem.is_sw_writable %}
        axi_write(addr, wdata, resp);
            {%- else %}
        axi_read(addr, rdata, resp);
            {%- endif %}
        {{ mem.name }}_range_invalid_access = 1'b0;
        check_error_resp(addr, resp);

            {%- if mem.is_sw_writable %}
        for (i = 0; i < {{ mem.mementries }}; i = i + 1) begin
            addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address) }} + i * 4);
            wdata = $urandom();
            {{ mem.name }}_exp[i] = wdata[{{ mem.width-1 }}:0];
            axi_write(addr, wdata, resp);
            check_resp(addr, resp);
        end
        // Partial byte write through the external memory byte-enable interface.
        addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address) }});
        wdata = $urandom();
        be = {{ '{:2.0f}'.format(data_width/8) }}'h5;
        {{ mem.name }}_exp[0] = ({{ mem.name }}_exp[0] & ~{{ mem.width }}'h00ff00ff) |
                               (wdata[{{ mem.width-1 }}:0] & {{ mem.width }}'h00ff00ff);
        axi_write_be(addr, wdata, be, resp);
        check_resp(addr, resp);
        // WSTRB=0 must not issue a physical memory write, but still responds OK.
        wdata = $urandom();
        axi_write_be(addr, wdata, { {{ '{:2.0f}'.format(data_width/8) }}{1'b0} }, resp);
        check_resp(addr, resp);
            {%- endif %}
            {%- if mem.is_sw_readable %}
        for (i = 0; i < {{ mem.mementries }}; i = i + 1) begin
            addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address) }} + i * 4);
            axi_read(addr, rdata, resp);
            check_resp(addr, resp);
                {%- if mem.is_sw_writable %}
            check_data(addr, rdata[{{ mem.width-1 }}:0], {{ mem.name }}_exp[i]);
                {%- endif %}
        end
            {%- endif %}
            {%- if not mem.is_sw_writable %}
        // Writes prohibited by the RDL sw property must not reach the memory.
        addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address) }});
        wdata = $urandom();
        axi_write(addr, wdata, resp);
        check_error_resp(addr, resp);
            {%- endif %}
            {%- if not mem.is_sw_readable %}
        // Reads prohibited by the RDL sw property must not reach the memory.
        addr = {{ addr_width }}'('h{{ '{:x}'.format(mem.address) }});
        axi_read(addr, rdata, resp);
        check_error_resp(addr, resp);
            {%- endif %}
        {%- endfor %}
        #1000;
        if (errors == 0) begin
            $display("TEST PASSED");
            $finish;
        end else begin
            $display("TEST FAILED: %0d error(s)", errors);
            $fatal(1);
        end
    end

endmodule

`default_nettype wire
